<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>UPI Locked QR Generator</title>
  <style>
    * { box-sizing: border-box; font-family: system-ui, -apple-system, sans-serif; }
    body { background: #f4f6f8; display: flex; align-items: center; justify-content: center; min-height: 100vh; margin: 0; padding: 16px; }
    .card { background: #fff; padding: 24px; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); width: 100%; max-width: 360px; text-align: center; }
    h2 { margin: 0 0 16px; font-size: 20px; color: #111; }
    input { width: 100%; padding: 12px; font-size: 18px; border: 2px solid #e2e8f0; border-radius: 10px; margin-bottom: 12px; text-align: center; outline: none; }
    input:focus { border-color: #000; }
    button { width: 100%; padding: 12px; background: #000; color: #fff; font-size: 16px; font-weight: 600; border: none; border-radius: 10px; cursor: pointer; }
    button:active { transform: scale(0.98); }
    #qrContainer { margin-top: 20px; display: none; }
    #qrImg { width: 220px; height: 220px; border-radius: 12px; border: 1px solid #eee; }
    .note { margin-top: 8px; font-size: 13px; color: #666; font-weight: 500; }
  </style>
</head>
<body>

  <div class="card">
    <h2>Instant Payment QR</h2>
    <input type="number" id="amountInput" placeholder="Amount daalo (₹)" min="1" autofocus />
    <button onclick="generateQR()">Generate QR</button>

    <div id="qrContainer">
      <img id="qrImg" src="" alt="UPI QR" />
      <div class="note" id="amountDisplay"></div>
    </div>
  </div>

  <script>
    // Yahan apni details set karein:
    const UPI_ID = "8076757060@slc"; // e.g. 9876543210@slice
    const PAYEE_NAME = "ANSHUL PAL";     // e.g. Anshul

    function generateQR() {
      const amount = document.getElementById('amountInput').value.trim();
      if (!amount || amount <= 0) {
        alert("Sahi amount enter karein!");
        return;
      }

      // UPI URI with am & mam (amount locking)
      const upiUrl = `upi://pay?pa=${encodeURIComponent(UPI_ID)}&pn=${encodeURIComponent(PAYEE_NAME)}&am=${amount}&cu=INR&mam=${amount}`;
      
      // Free QR API se fetch karna
      const qrApiUrl = `https://api.qrserver.com/v1/create-qr-code/?size=300x300&data=${encodeURIComponent(upiUrl)}`;

      document.getElementById('qrImg').src = qrApiUrl;
      document.getElementById('amountDisplay').innerText = `Locked Amount: ₹${amount}`;
      document.getElementById('qrContainer').style.display = 'block';
    }
  </script>

</body>
</html>
